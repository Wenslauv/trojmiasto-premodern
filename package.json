{
  "name": "trojmiasto-premodern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate-data",
    "dev": "vite",
    "prebuild": "npm run generate-data",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "test:update": "UPDATE_SNAPSHOTS=1 npm test",
    "preview": "vite preview",
    "new-event-file": "node scripts/new-event-file.mjs",
    "new-standings-file": "node scripts/new-event-file.mjs --mode standings",
    "add-event": "node scripts/add-event.mjs",
    "add-event-compact": "node scripts/add-event-compact.mjs",
    "update-event": "node scripts/update-event.mjs",
    "rename-player": "node scripts/rename-player.mjs",
    "generate-data": "node scripts/generate-data.mjs",
    "generate-matrix": "node scripts/generate-data.mjs --matrix-only",
    "reset-matrix": "node scripts/generate-data.mjs --matrix-only --reset-matchups",
    "check-data": "node scripts/generate-data.mjs --check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
